# =============================================================================
# NestIQ — environment template
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# =============================================================================

# --- Site ---------------------------------------------------------------
# Absolute base URL, no trailing slash. Used for canonicals, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required — the app will not build without these) ----------
# Project settings → API. The anon key is public and safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-only — bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Some server scripts read SUPABASE_URL rather than the NEXT_PUBLIC_ variant.
# Set it to the same value as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project.supabase.co

# --- Algolia (search) ----------------------------------------------------
NEXT_PUBLIC_ALGOLIA_APP_ID=your-app-id
# Admin key: server-only, used by the sync job and index setup.
ALGOLIA_ADMIN_KEY=your-admin-key
# Search-only key for the browser. Safe to expose; scope it to search.
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your-search-only-key

# --- Mapbox (maps) -------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-public-token

# --- Anthropic (AI descriptions, search, valuations) ---------------------
ANTHROPIC_API_KEY=sk-ant-your-key

# --- Stripe (agent subscriptions) ----------------------------------------
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- Resend (transactional email) ----------------------------------------
RESEND_API_KEY=re_your-key
# Must be a verified sender on your Resend domain.
RESEND_FROM_EMAIL=hello@nestiq.co.uk

# --- Cron ----------------------------------------------------------------
# Shared secret guarding /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string
